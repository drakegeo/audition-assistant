# Copy this file to .env and fill in real values for local development.
# Never commit .env — it contains secrets.
#
# Run `cd backend && uv sync` after first checkout to install dependencies
# and generate uv.lock. Then `uv run uvicorn src.api.main:app --reload`.

# --- Supabase ---
# From: Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- LLM provider (choose one) ---
# Set LLM_PROVIDER to 'anthropic' or 'groq', then fill in the matching key.
LLM_PROVIDER=groq

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Default model when using Groq:
LLM_MODEL=llama-3.3-70b-versatile

# Anthropic — https://console.anthropic.com/settings/keys
# (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# Default model when using Anthropic:
# LLM_MODEL=claude-haiku-4-5-20251001

# --- App config ---
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=DEBUG
