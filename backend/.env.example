# Copy this file to .env and fill in real values for local development.
# Never commit .env — it contains secrets.
#
# Run `cd backend && uv sync` after first checkout to install dependencies
# and generate uv.lock. Then `uv run uvicorn src.api.main:app --reload`.

# --- Supabase ---
# From: Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Anthropic ---
# From: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- App config ---
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=DEBUG
LLM_MODEL=claude-haiku-4-5-20251001
